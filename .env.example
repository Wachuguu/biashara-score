# ==============================================================================
# Biashara Score - Environment Variables Example
# Duplicate this file as '.env' for local development:
#   cp .env.example .env
# NEVER commit your actual '.env' or AWS secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT MODE (No AWS account required)
# ------------------------------------------------------------------------------
# Set to 'true' to mock DynamoDB, S3, and Bedrock calls with local JSON/CSV files
MOCK_AWS=true
LOCAL_SAMPLE_DATA_PATH=sample-data/mpesa_statement.csv

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js / Amplify)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Biashara Score"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AWS_REGION=eu-west-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-west-1_mockPoolId
NEXT_PUBLIC_COGNITO_CLIENT_ID=mockClientId1234567890

# ------------------------------------------------------------------------------
# AWS CLOUD CONFIGURATION (Used by single deployer in deployed environment)
# ------------------------------------------------------------------------------
AWS_REGION=eu-west-1
ENVIRONMENT=dev

# DynamoDB Table Names (Provisioned via SAM)
DYNAMODB_TRANSACTIONS_TABLE=biashara-transactions-dev
DYNAMODB_BUSINESS_TABLE=biashara-businesses-dev
DYNAMODB_DEBTS_TABLE=biashara-debts-dev

# S3 Storage
S3_STATEMENTS_BUCKET=biashara-statements-upload-dev

# Amazon Bedrock (For LLM transaction categorization fallback)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ------------------------------------------------------------------------------
# AFRICA'S TALKING SMS NOTIFICATIONS (Kenyan Telco Integration)
# ------------------------------------------------------------------------------
# Sign up at https://africastalking.com (Sandbox is free for testing)
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=atsk_sandbox_your_api_key_here
AFRICAS_TALKING_SENDER_ID=BIASHARA
