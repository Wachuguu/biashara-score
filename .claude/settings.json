{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(./secrets/**)"
    ],
    "allow": [
      "Bash(make *)",
      "Bash(git *)",
      "Bash(npm run *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/production-gate.sh"
          }
        ]
      }
    ]
  }
}
